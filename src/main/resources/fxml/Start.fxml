<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<BorderPane prefHeight="800.0" prefWidth="1200.0" style="         -fx-background-image: url('images/MainMenuBG.png');         -fx-background-size: cover;         -fx-background-position: center;     " xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.clientside.controllers.StartController">
    <top>
        <BorderPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <right>
                <HBox alignment="CENTER_RIGHT" prefHeight="130.0" prefWidth="404.0" spacing="24.0" BorderPane.alignment="CENTER">
                    <children>
                        <Label fx:id="leaderBoardText" onMouseClicked="#goToLeaderBoard" text="LeaderBoard" underline="true">
                            <font>
                                <Font name="Comic Sans MS" size="36.0" />
                            </font>
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Label>
                        <ImageView fx:id="settingsIcon" fitHeight="80.0" fitWidth="80.0" onMouseClicked="#goToSettings" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/settings.png" />
                            </image>
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </ImageView>
                    </children>
                </HBox>
            </right>
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
        </BorderPane>
    </top>
    <center>
        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="24.0" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="32.0">
                    <children>
                        <Button id="start-button" fx:id="startBtn" mnemonicParsing="false" onAction="#handleStart" prefHeight="130.0" prefWidth="374.0" style="-fx-background-color: #89CFF0; -fx-border-color: black; -fx-border-width: 2; -fx-border-radius: 50; -fx-background-radius: 50; -fx-border-style: dashed;" styleClass="start-button" stylesheets="@../styles/app.css" text="Start" textAlignment="CENTER">
                            <font>
                                <Font name="Comic Sans MS" size="48.0" />
                            </font>
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                        <Button id="recordings-button" fx:id="recordingBtn" mnemonicParsing="false" onAction="#handleRecording" prefHeight="130.0" prefWidth="374.0" style="-fx-background-color: #FFF94B; -fx-border-color: black; -fx-border-width: 2; -fx-background-radius: 50; -fx-border-radius: 50;" styleClass="recordings-button" stylesheets="@../styles/app.css" text="Recordings">
                            <font>
                                <Font name="Comic Sans MS" size="48.0" />
                            </font>
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                    </children>
                </HBox>
                <Button id="exit-button" fx:id="exitBtn" mnemonicParsing="false" onAction="#handleExit" prefHeight="100.0" prefWidth="374.0" style="-fx-background-color: #F34B4E; -fx-border-color: black; -fx-border-width: 2; -fx-background-radius: 50; -fx-border-radius: 50;" styleClass="exit-button" stylesheets="@../styles/app.css" text="Exit" textAlignment="CENTER">
                    <font>
                        <Font name="Comic Sans MS" size="48.0" />
                    </font>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Button>
            </children>
        </VBox>
    </center>
</BorderPane>