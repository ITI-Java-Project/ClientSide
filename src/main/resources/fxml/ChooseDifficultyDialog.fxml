<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane pickOnBounds="true" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.mycompany.clientside.controllers.ChooseDifficultyDialogController">

    <Pane fx:id="backgroundPane" style="-fx-background-color: rgba(0,0,0,0.5);" StackPane.alignment="CENTER" />

    <VBox fx:id="dialogCard"
          alignment="CENTER"
          maxHeight="350"
          maxWidth="420"
          prefHeight="350"
          prefWidth="420"
          spacing="20"
          style="
              -fx-background-color: white;
              -fx-background-radius: 40;
              -fx-border-radius: 40;
              -fx-border-color: black;
              -fx-border-width: 2;
          ">

        <padding>
            <Insets bottom="25" left="25" right="25" top="25" />
        </padding>

        <Label fx:id="titleLabel" text="Choose Difficulty">
            <font>
                <Font name="Comic Sans MS Bold" size="22.0" />
            </font>
        </Label>

        <VBox alignment="CENTER" spacing="15">
            <Button fx:id="easyButton" onAction="#chooseEasy" prefHeight="50" prefWidth="200" 
                    style="-fx-background-color: #2ecc71; -fx-border-color: black; -fx-border-width: 3; -fx-background-radius: 15; -fx-border-radius: 15;" 
                    text="Easy">
                <font>
                    <Font name="Comic Sans MS Bold" size="18.0" />
                </font>
            </Button>
            
            <Button fx:id="mediumButton" onAction="#chooseMedium" prefHeight="50" prefWidth="200" 
                    style="-fx-background-color: #f39c12; -fx-border-color: black; -fx-border-width: 3; -fx-background-radius: 15; -fx-border-radius: 15;" 
                    text="Medium">
                <font>
                    <Font name="Comic Sans MS Bold" size="18.0" />
                </font>
            </Button>
            
            <Button fx:id="hardButton" onAction="#chooseHard" prefHeight="50" prefWidth="200" 
                    style="-fx-background-color: #e74c3c; -fx-border-color: black; -fx-border-width: 3; -fx-background-radius: 15; -fx-border-radius: 15;" 
                    text="Hard">
                <font>
                    <Font name="Comic Sans MS Bold" size="18.0" />
                </font>
            </Button>
        </VBox>

        <Button fx:id="cancelButton" onAction="#cancel" prefHeight="40" prefWidth="120" 
                style="-fx-background-color: #95a5a6; -fx-border-color: black; -fx-border-width: 2; -fx-background-radius: 50; -fx-border-radius: 50;" 
                text="Cancel">
            <font>
                <Font name="Comic Sans MS Bold" size="14.0" />
            </font>
        </Button>

    </VBox>
</StackPane>