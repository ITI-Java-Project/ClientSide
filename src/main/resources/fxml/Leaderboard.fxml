<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.clientside.controllers.LeaderboardController">
    <children>
        <!-- Background -->
        <ImageView fx:id="bgImage" fitHeight="${bgImage.parent.height}" fitWidth="${bgImage.parent.width}" pickOnBounds="true" preserveRatio="false">
            <image>
                <Image url="@../images/DefaultMenuBG.png" />
            </image>
        </ImageView>

        <BorderPane>

            <!-- TOP BAR -->
            <top>
                <BorderPane prefHeight="200.0" prefWidth="200.0">
                    <padding>
                        <Insets bottom="24" left="24" right="24" top="24" />
                    </padding>

                    <left>
                        <ImageView fitHeight="60" fitWidth="60" onMouseClicked="#handleBack" preserveRatio="true" BorderPane.alignment="CENTER">
                            <image>
                                <Image url="@../images/arrow.png" />
                            </image>
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </ImageView>
                    </left>

                    <right>
                        <ImageView fitHeight="60" fitWidth="60" onMouseClicked="#goToSettings" preserveRatio="true" BorderPane.alignment="CENTER">
                            <image>
                                <Image url="@../images/settings.png" />
                            </image>
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </ImageView>
                    </right>
                </BorderPane>
            </top>

            <!-- CENTER -->
            <center>
                <VBox alignment="TOP_CENTER" spacing="20">
                    <padding>
                        <Insets bottom="40" left="40" right="40" />
                    </padding>

                    <Label text="LEADERBOARD">
                        <font>
                            <Font name="Comic Sans MS Bold" size="48" />
                        </font>
                        <VBox.margin>
                            <Insets bottom="40" />
                        </VBox.margin>
                    </Label>

                    <!-- Leaderboard Container -->
                    <VBox maxWidth="973" prefWidth="973" style="-fx-background-color: rgba(255,255,255,0.7); -fx-background-radius: 20; -fx-border-color: black; -fx-border-radius: 20; -fx-border-width: 2;">
                        <padding>
                            <Insets bottom="20" left="20" right="20" top="20" />
                        </padding>

                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="NEVER">
                            <content>
                                <VBox spacing="15">

                                    <!-- FIRST -->
                                    <HBox alignment="CENTER" spacing="100" style="-fx-background-color: #FFD84D; -fx-background-radius: 30; -fx-border-color: black; -fx-border-radius: 30; -fx-border-width: 2;">
                                        <padding><Insets bottom="15" left="25" right="25" top="15" /></padding>
                                        <HBox spacing="100.0" HBox.hgrow="ALWAYS">
                                            <ImageView fitHeight="40" fitWidth="40"><image><Image url="@../images/player.png" /></image></ImageView>
                                            <Label text="Player One" textFill="#050505"><font><Font name="Comic Sans MS" size="22" /></font></Label>
                                        </HBox>
                                        <HBox alignment="CENTER_RIGHT" spacing="15" HBox.hgrow="ALWAYS">
                                            <Label text="Tic-Tac Legend" textFill="#00000080"><font><Font name="Comic Sans MS" size="12.0" /></font></Label>
                                            <ImageView fitHeight="30" fitWidth="30"><image><Image url="@../images/king.png" /></image></ImageView>
                                            <Label text="Score: 20" textFill="#050505"><font><Font name="Comic Sans MS" size="18" /></font></Label>
                                        </HBox>
                                    </HBox>

                                    <!-- SECOND -->
                                    <HBox alignment="CENTER" spacing="100" style="-fx-background-color: #CFCFCF; -fx-background-radius: 30; -fx-border-color: black; -fx-border-radius: 30; -fx-border-width: 2;">
                                        <padding><Insets bottom="15" left="25" right="25" top="15" /></padding>
                                        <HBox spacing="100.0" HBox.hgrow="ALWAYS">
                                            <ImageView fitHeight="40" fitWidth="40"><image><Image url="@../images/player.png" /></image></ImageView>
                                            <Label text="Player Two" textFill="#050505"><font><Font name="Comic Sans MS" size="22" /></font></Label>
                                        </HBox>
                                        <HBox alignment="CENTER_RIGHT" spacing="15" HBox.hgrow="ALWAYS">
                                            <Label text="Grid Master" textFill="#00000080"><font><Font name="Comic Sans MS" size="12.0" /></font></Label>
                                            <Label text="Score: 15" textFill="#050505"><font><Font name="Comic Sans MS" size="18" /></font></Label>
                                        </HBox>
                                    </HBox>

                                    <!-- THIRD -->
                                    <HBox alignment="CENTER" spacing="100" style="-fx-background-color: #D6862F; -fx-background-radius: 30; -fx-border-color: black; -fx-border-radius: 30; -fx-border-width: 2;">
                                        <padding><Insets bottom="15" left="25" right="25" top="15" /></padding>
                                        <HBox spacing="100.0" HBox.hgrow="ALWAYS">
                                            <ImageView fitHeight="40" fitWidth="40"><image><Image url="@../images/player.png" /></image></ImageView>
                                            <Label text="Player Three" textFill="#050505"><font><Font name="Comic Sans MS" size="22" /></font></Label>
                                        </HBox>
                                        <HBox alignment="CENTER_RIGHT" spacing="15" HBox.hgrow="ALWAYS">
                                            <Label text="Smart Player" textFill="#00000080"><font><Font name="Comic Sans MS" size="12.0" /></font></Label>
                                            <Label text="Score: 10" textFill="#050505"><font><Font name="Comic Sans MS" size="18" /></font></Label>
                                        </HBox>
                                    </HBox>

                                    <!-- ADDITIONAL PLAYERS -->
                                    <HBox alignment="CENTER" spacing="100" style="-fx-background-color: #E0E0E0; -fx-background-radius: 30; -fx-border-color: black; -fx-border-radius: 30; -fx-border-width: 2;">
                                        <padding><Insets bottom="15" left="25" right="25" top="15" /></padding>
                                        <HBox spacing="100.0" HBox.hgrow="ALWAYS">
                                            <ImageView fitHeight="40" fitWidth="40"><image><Image url="@../images/player.png" /></image></ImageView>
                                            <Label text="Player Four" textFill="#050505"><font><Font name="Comic Sans MS" size="22" /></font></Label>
                                        </HBox>
                                        <HBox alignment="CENTER_RIGHT" spacing="15" HBox.hgrow="ALWAYS">
                                            <Label text="Rookie" textFill="#0a090980"><font><Font name="Comic Sans MS" size="10.0" /></font></Label>
                                            <Label text="Score: 8" textFill="#050505"><font><Font name="Comic Sans MS" size="18" /></font></Label>
                                        </HBox>
                                    </HBox>

                                    <HBox alignment="CENTER" spacing="100" style="-fx-background-color: #E0E0E0; -fx-background-radius: 30; -fx-border-color: black; -fx-border-radius: 30; -fx-border-width: 2;">
                                        <padding><Insets bottom="15" left="25" right="25" top="15" /></padding>
                                        <HBox spacing="100.0" HBox.hgrow="ALWAYS">
                                            <ImageView fitHeight="40" fitWidth="40"><image><Image url="@../images/player.png" /></image></ImageView>
                                            <Label text="Player Five" textFill="#050505"><font><Font name="Comic Sans MS" size="22" /></font></Label>
                                        </HBox>
                                        <HBox alignment="CENTER_RIGHT" spacing="15" HBox.hgrow="ALWAYS">
                                            <Label text="Challenger" textFill="#03030380"><font><Font name="Comic Sans MS" size="10.0" /></font></Label>
                                            <Label text="Score: 7" textFill="#050505"><font><Font name="Comic Sans MS" size="18" /></font></Label>
                                        </HBox>
                                    </HBox>

                                    <HBox alignment="CENTER" spacing="100" style="-fx-background-color: #E0E0E0; -fx-background-radius: 30; -fx-border-color: black; -fx-border-radius: 30; -fx-border-width: 2;">
                                        <padding><Insets bottom="15" left="25" right="25" top="15" /></padding>
                                        <HBox spacing="100.0" HBox.hgrow="ALWAYS">
                                            <ImageView fitHeight="40" fitWidth="40"><image><Image url="@../images/player.png" /></image></ImageView>
                                            <Label text="Player Six" textFill="#050505"><font><Font name="Comic Sans MS" size="22" /></font></Label>
                                        </HBox>
                                        <HBox alignment="CENTER_RIGHT" spacing="15" HBox.hgrow="ALWAYS">
                                            <Label text="Newbie" textFill="#03030380"><font><Font name="Comic Sans MS" size="10.0" /></font></Label>
                                            <Label text="Score: 5" textFill="#050505"><font><Font name="Comic Sans MS" size="18" /></font></Label>
                                        </HBox>
                                    </HBox>

                                </VBox>
                            </content>
                        </ScrollPane>
                    </VBox>
                </VBox>
            </center>
        </BorderPane>
    </children>
</StackPane>
