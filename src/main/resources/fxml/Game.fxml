<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.mycompany.clientside.controllers.GameController" 
           prefHeight="800.0" prefWidth="1200.0"
           style="-fx-background-image: url('images/GameBG.png'); 
                  -fx-background-size: cover; 
                  -fx-background-position: center;">
    
    <!-- Top Section: Players Info and Score -->
    <top>
        <VBox alignment="CENTER" style="-fx-padding: 40 50 30 50;">
            <!-- Players Info and Score - Centered -->
            <HBox alignment="CENTER" spacing="80">

                <!-- Player 1 Info -->
                <HBox alignment="CENTER" spacing="20">
                    <ImageView fx:id="player1Avatar" fitWidth="90" fitHeight="90" preserveRatio="true">
                        <Image url="images/Player1.png"/>
                    </ImageView>
                    <VBox alignment="CENTER" spacing="8">
                        <Label fx:id="player1Name" text="Player Name"
                               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                        <Label text="X" style="-fx-font-size: 32px; -fx-font-weight: bold;"/>
                    </VBox>
                </HBox>

                <!-- Score Display -->
                <VBox alignment="CENTER" spacing="5">
                    <HBox spacing="25" alignment="CENTER">
                        <Label fx:id="player1Score" text="1"
                               style="-fx-font-size: 42px; -fx-font-weight: bold;"/>
                        <Label text="-" style="-fx-font-size: 42px; -fx-font-weight: bold;"/>
                        <Label fx:id="drawScore" text="1"
                               style="-fx-font-size: 42px; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <!-- Player 2 Info -->
                <HBox alignment="CENTER" spacing="20">
                    <VBox alignment="CENTER" spacing="8">
                        <Label fx:id="player2Name" text="Player Name"
                               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                        <Label text="O" style="-fx-font-size: 32px; -fx-font-weight: bold;"/>
                    </VBox>
                    <ImageView fx:id="player2Avatar" fitWidth="90" fitHeight="90" preserveRatio="true">
                        <Image url="images/Player2.png"/>
                    </ImageView>
                </HBox>

            </HBox>
            
            <!-- Settings Button - Positioned separately below -->
            <HBox alignment="TOP_RIGHT" style="-fx-padding: 10 0 0 0;">
                <Button fx:id="settingsButton"
                        onAction="#handleSettingClick"
                        prefWidth="140"
                        prefHeight="140"
                        minWidth="140"
                        minHeight="140"
                        maxWidth="140"
                        maxHeight="140"
                        style="-fx-background-color: transparent; -fx-padding: 0;"/>
            </HBox>
        </VBox>
    </top>
    
    <!-- Center: Game Board -->
    <center>
        <StackPane alignment="CENTER" style="-fx-padding: 0 0 100 0;">
            <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
                <GridPane fx:id="gameBoard" alignment="CENTER" hgap="0" vgap="0">
                
                <!-- Row 0 -->
                <Button fx:id="cell00" prefWidth="180" prefHeight="180" onAction="#handleCellClick"
                        style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand; -fx-font-size: 72px; -fx-font-weight: bold;"
                        GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Button fx:id="cell01" prefWidth="180" prefHeight="180" onAction="#handleCellClick"
                        style="-fx-background-color: transparent; -fx-border-color: #333333; -fx-border-width: 0 8 0 8; -fx-cursor: hand; -fx-font-size: 72px; -fx-font-weight: bold;"
                        GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Button fx:id="cell02" prefWidth="180" prefHeight="180" onAction="#handleCellClick"
                        style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand; -fx-font-size: 72px; -fx-font-weight: bold;"
                        GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                
                <!-- Row 1 -->
                <Button fx:id="cell10" prefWidth="180" prefHeight="180" onAction="#handleCellClick"
                        style="-fx-background-color: transparent; -fx-border-color: #333333; -fx-border-width: 8 0 8 0; -fx-cursor: hand; -fx-font-size: 72px; -fx-font-weight: bold;"
                        GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Button fx:id="cell11" prefWidth="180" prefHeight="180" onAction="#handleCellClick"
                        style="-fx-background-color: transparent; -fx-border-color: #333333; -fx-border-width: 8 8 8 8; -fx-cursor: hand; -fx-font-size: 72px; -fx-font-weight: bold;"
                        GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Button fx:id="cell12" prefWidth="180" prefHeight="180" onAction="#handleCellClick"
                        style="-fx-background-color: transparent; -fx-border-color: #333333; -fx-border-width: 8 0 8 0; -fx-cursor: hand; -fx-font-size: 72px; -fx-font-weight: bold;"
                        GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                
                <!-- Row 2 -->
                <Button fx:id="cell20" prefWidth="180" prefHeight="180" onAction="#handleCellClick"
                        style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand; -fx-font-size: 72px; -fx-font-weight: bold;"
                        GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Button fx:id="cell21" prefWidth="180" prefHeight="180" onAction="#handleCellClick"
                        style="-fx-background-color: transparent; -fx-border-color: #333333; -fx-border-width: 0 8 0 8; -fx-cursor: hand; -fx-font-size: 72px; -fx-font-weight: bold;"
                        GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Button fx:id="cell22" prefWidth="180" prefHeight="180" onAction="#handleCellClick"
                        style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-cursor: hand; -fx-font-size: 72px; -fx-font-weight: bold;"
                        GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                </GridPane>
            </VBox>
        </StackPane>
    </center>
    
</BorderPane>