<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane stylesheets="@../styles/app.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.clientside.controllers.AvaliablePlayersController" style="-fx-background-image: url('images/DefaultMenuBG.png'); -fx-background-size: cover; -fx-background-position: center;">
    <children>
        <BorderPane>

            <center>
                <VBox alignment="TOP_CENTER" spacing="20.0" BorderPane.alignment="CENTER">
                    <children>
                        <Label text="Available players">
                            <font>
                                <Font name="Comic Sans MS Bold" size="48.0" />
                            </font>
                            <VBox.margin>
                                <Insets />
                            </VBox.margin>
                            <padding>
                                <Insets bottom="40.0" />
                            </padding>
                        </Label>
                  
                        <VBox maxWidth="973.0" prefHeight="489.0" prefWidth="973.0" style="-fx-background-color: rgba(255,255,255,0.7); -fx-background-radius: 20; -fx-border-color: black; -fx-border-radius: 20; -fx-border-width: 2;">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="NEVER">
                                    <content>
                                        <VBox fx:id="playersListContainer" spacing="15.0">
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets left="40.0" right="40.0" />
                    </padding>
                </VBox>
            </center>
            <top>
                <BorderPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
                    <right>
                        <HBox alignment="CENTER_RIGHT" spacing="24.0" BorderPane.alignment="CENTER">
                            <children>
                                <Label fx:id="leaderBoardText" onMouseClicked="#goToLeaderBoard" text="LeaderBoard" underline="true">
                                    <font>
                                        <Font name="Comic Sans MS" size="24.0" />
                                    </font>
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </Label>
                                <ImageView fx:id="refreshIcon" fitHeight="60.0" fitWidth="60.0" onMouseClicked="#handleRefresh" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/refresh.png" />
                                    </image>
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </ImageView>
                                <ImageView fx:id="settingsIcon" fitHeight="60.0" fitWidth="60.0" onMouseClicked="#goToSettings" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/settings.png" />
                                    </image>
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </ImageView>
                            </children>
                        </HBox>
                    </right>
                    <left>
                        <ImageView fx:id="backIcon" fitHeight="60.0" fitWidth="60.0" onMouseClicked="#handleBack" pickOnBounds="true" preserveRatio="true" BorderPane.alignment="CENTER">
                            <image>
                                <Image url="@../images/arrow.png" />
                            </image>
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                            <BorderPane.margin>
                                <Insets top="60" left="30" />
                            </BorderPane.margin>
                        </ImageView>
                    </left>
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                    </padding>
                </BorderPane>
            </top>
        </BorderPane>
    </children>
</StackPane>