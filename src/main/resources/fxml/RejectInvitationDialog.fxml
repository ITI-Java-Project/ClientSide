<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>


<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mycompany.clientside.controllers.RejectInvitationDialogController"
            prefWidth="400" prefHeight="220"
            style="-fx-background-color: white; -fx-background-radius: 20;">

    <VBox  alignment="CENTER"
           maxHeight="260"
           maxWidth="420"
           prefHeight="260"
           prefWidth="420"
           spacing="25"
           style="
          -fx-background-color: white;
          -fx-background-radius: 40;
          -fx-border-radius: 40;
          -fx-border-color: black;
          -fx-border-width: 2;
      ">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <Label fx:id="messageLabel"  text="Invitation Rejected">
            <font>
                <Font name="Comic Sans MS Bold" size="18"/>
            </font>
        </Label>

        <Button
            text="Exit"
            prefWidth="160"
            prefHeight="60"
            alignment="CENTER"
            onAction="#close"
            style="
                -fx-background-color: #F34B4E;
                -fx-background-radius: 50;
                -fx-border-radius: 50;
                -fx-border-color: black;
                -fx-border-width: 2; ">
            <font>
                <Font name="Comic Sans MS Bold" size="14"/>
            </font>
        </Button>

    </VBox>
</AnchorPane>