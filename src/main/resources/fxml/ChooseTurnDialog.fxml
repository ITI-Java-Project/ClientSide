<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane pickOnBounds="true" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.mycompany.clientside.controllers.ChooseTurnDialogController">

    <Pane fx:id="backgroundPane" style="-fx-background-color: rgba(0,0,0,0.5);" StackPane.alignment="CENTER" />

    <VBox fx:id="dialogCard"
          alignment="CENTER"
          maxHeight="280"
          maxWidth="420"
          prefHeight="280"
          prefWidth="420"
          spacing="25"
          style="
              -fx-background-color: white;
              -fx-background-radius: 40;
              -fx-border-radius: 40;
              -fx-border-color: black;
              -fx-border-width: 2;
          ">

        <padding>
            <Insets bottom="25" left="25" right="25" top="25" />
        </padding>

        <Label fx:id="titleLabel" text="Choose Your Side">
            <font>
                <Font name="Comic Sans MS Bold" size="20.0" />
            </font>
        </Label>

        <HBox alignment="CENTER" spacing="30">
            <Button fx:id="xButton" onAction="#chooseX" prefHeight="80" prefWidth="80" 
                    style="-fx-background-color: #3498db; -fx-border-color: black; -fx-border-width: 3; -fx-background-radius: 15; -fx-border-radius: 15;" 
                    text="X">
                <font>
                    <Font name="Comic Sans MS Bold" size="36.0" />
                </font>
            </Button>
            
            <Button fx:id="oButton" onAction="#chooseO" prefHeight="80" prefWidth="80" 
                    style="-fx-background-color: #e74c3c; -fx-border-color: black; -fx-border-width: 3; -fx-background-radius: 15; -fx-border-radius: 15;" 
                    text="O">
                <font>
                    <Font name="Comic Sans MS Bold" size="36.0" />
                </font>
            </Button>
        </HBox>

        <Button fx:id="cancelButton" onAction="#cancel" prefHeight="45" prefWidth="140" 
                style="-fx-background-color: #95a5a6; -fx-border-color: black; -fx-border-width: 2; -fx-background-radius: 50; -fx-border-radius: 50;" 
                text="Cancel">
            <font>
                <Font name="Comic Sans MS Bold" size="14.0" />
            </font>
        </Button>

    </VBox>
</StackPane>