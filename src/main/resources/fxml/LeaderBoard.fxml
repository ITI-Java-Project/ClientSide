<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/11"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mycompany.clientside.controllers.LeaderBoardController"
           style="-fx-background-image: url('images/DefaultMenuBG.png');
                  -fx-background-size: cover;
                  -fx-background-position: center;">

    <children>
        <BorderPane>

            <top>
                <BorderPane>
                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>

                    <left>
                        <ImageView fx:id="backBtn"
                                   fitHeight="60"
                                   fitWidth="60"
                                   preserveRatio="true"
                                   onMouseClicked="#handleBack"
                                   BorderPane.alignment="CENTER">
                            <image>
                                <Image url="@../images/arrow.png"/>
                            </image>
                            <cursor>
                                <Cursor fx:constant="HAND"/>
                            </cursor>
                            <BorderPane.margin>
                                <Insets top="60" left="30"/>
                            </BorderPane.margin>
                        </ImageView>
                    </left>

                    <right>
                        <ImageView fx:id="settingsIcon"
                                   fitHeight="60"
                                   fitWidth="60"
                                   preserveRatio="true"
                                   onMouseClicked="#goToSettings"
                                   BorderPane.alignment="CENTER">
                            <image>
                                <Image url="@../images/settings.png"/>
                            </image>
                            <cursor>
                                <Cursor fx:constant="HAND"/>
                            </cursor>
                        </ImageView>
                    </right>
                </BorderPane>
            </top>

            <center>
                <VBox alignment="TOP_CENTER" spacing="20">
                    <padding>
                        <Insets left="40" right="40" bottom="40"/>
                    </padding>

                    <!-- TITLE -->
                    <Label text="LEADERBOARD">
                        <font>
                            <Font name="Comic Sans MS Bold" size="48"/>
                        </font>
                        <VBox.margin>
                            <Insets bottom="40"/>
                        </VBox.margin>
                    </Label>

                    <VBox style="-fx-background-color: rgba(255,255,255,0.7);
                                 -fx-background-radius: 20;
                                 -fx-border-color: black;
                                 -fx-border-radius: 20;
                                 -fx-border-width: 2;">
                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <ScrollPane fitToWidth="true"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="NEVER"
                                    pannable="true"
                                    style="-fx-background-color: transparent;
                                           -fx-background: transparent;">
                            <content>
                                <VBox fx:id="playersListContainer"
                                      spacing="15"/>
                            </content>
                        </ScrollPane>
                    </VBox>

                </VBox>
            </center>

        </BorderPane>
    </children>
</StackPane>
