<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.text.Font?>

<StackPane pickOnBounds="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.mycompany.clientside.controllers.VideoDialogController">

    <Pane fx:id="backgroundPane" style="-fx-background-color: rgba(0,0,0,0.5);" />

    <VBox fx:id="dialogCard"
          alignment="CENTER"
          maxHeight="700"
          maxWidth="860"
          spacing="20"
          style="-fx-background-color: white; -fx-background-radius: 40; -fx-border-radius: 40; -fx-border-color: black; -fx-border-width: 2;">

        <padding>
            <Insets bottom="30" left="30" right="30" top="30" />
        </padding>

        <Label fx:id="titleLabel" text="You Won!">
            <font>
                <Font name="Comic Sans MS Bold" size="28.0" />
            </font>
        </Label>

        <MediaView fx:id="mediaView" fitHeight="500" fitWidth="800" />

        <HBox alignment="CENTER" spacing="30">
            
            <Button onAction="#goBack" prefHeight="60" prefWidth="160" 
                    style="-fx-background-color: #4CAF50; -fx-border-color: black; -fx-border-width: 2; -fx-background-radius: 50; -fx-border-radius: 50;" 
                    text="Go Back">
                <font>
                    <Font name="Comic Sans MS Bold" size="14.0" />
                </font>
            </Button>

            <Button fx:id="playAgainButton" 
                onAction="#playAgain" prefHeight="60" prefWidth="160" 
                    style="-fx-background-color: #2196F3; -fx-border-color: black; -fx-border-width: 2; -fx-background-radius: 50; -fx-border-radius: 50;" 
                    text="Play Again">
                <font>
                    <Font name="Comic Sans MS Bold" size="14.0" />
                </font>
            </Button>

        </HBox>

    </VBox>

</StackPane>