<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.Cursor?>


<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" spacing="100"
      style="-fx-border-color: black; -fx-border-radius: 30; -fx-padding: 10;">
    
    <children>
        <HBox alignment="CENTER" spacing="30" HBox.hgrow="ALWAYS">
            <children>
                <ImageView fx:id="playerImage" fitHeight="40" fitWidth="40" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/player.png"/>
                    </image>
                </ImageView>
                <Label fx:id="playerNameLabel" minWidth="150" text="Player Name" textFill="#0d0d0d">
                    <font> 
                        <Font name="Comic Sans MS" size="18.0" /> 
                    </font>
                </Label>
                <Label fx:id="playerStatusLabel" minWidth="100" text="● Online" textFill="#2ecc71">
                    <font> 
                        <Font name="Comic Sans MS" size="18.0" /> 
                    </font>
                </Label>
            </children>
        </HBox>

        <HBox alignment="CENTER" spacing="50" HBox.hgrow="ALWAYS">
            <children>
                <Label fx:id="playerScoreLabel" minWidth="100" text="Score: 0" textFill="#0d0d0d">  
                    <font> 
                        <Font name="Comic Sans MS" size="18.0" /> 
                    </font>
                </Label>
                <Label fx:id="challengeLabel" text="Challenge" textFill="#0d0d0d" underline="true">
                    <font> 
                        <Font name="Comic Sans MS" size="20.0" /> 
                    </font> 
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Label>
            </children>
        </HBox>
    </children>
</HBox>