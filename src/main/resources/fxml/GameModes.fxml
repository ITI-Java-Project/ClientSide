<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        styleClass="root-pane"
        stylesheets="@../styles/gameModes.css"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.mycompany.clientside.controllers.GameModesController">

    <top>
        <BorderPane prefHeight="200.0"
                    styleClass="header-padding"
                    BorderPane.alignment="CENTER">

            <left>
                <ImageView fx:id="backBtn"
                           fitHeight="80"
                           fitWidth="80"
                           preserveRatio="true"
                           onMouseClicked="#handleBack"
                           styleClass="clickable"
                           BorderPane.alignment="CENTER">
                    <image>
                        <Image url="@../images/arrow.png"/>
                    </image>
                </ImageView>
            </left>

            <right>
                <HBox alignment="CENTER_RIGHT"
                      spacing="24"
                      BorderPane.alignment="CENTER">

                    <children>
                        <Label fx:id="leaderBoardText"
                               text="LeaderBoard"
                               underline="true"
                               onMouseClicked="#goToLeaderBoard"
                               styleClass="clickable">
                            <font>
                                <Font name="Comic Sans MS" size="36"/>
                            </font>
                        </Label>

                        <ImageView fx:id="settingsIcon"
                                   fitHeight="80"
                                   fitWidth="80"
                                   preserveRatio="true"
                                   onMouseClicked="#goToSettings"
                                   styleClass="clickable">
                            <image>
                                <Image url="@../images/settings.png"/>
                            </image>
                        </ImageView>
                    </children>
                </HBox>
            </right>

        </BorderPane>
    </top>

    <center>
        <VBox alignment="CENTER"
              spacing="80">

            <Label text="Game Modes"
                   styleClass="page-title"/>

            <HBox alignment="CENTER"
                  spacing="500">

                <Button fx:id="onlineBtn"
                        text="Online"
                        prefWidth="374"
                        prefHeight="130"
                        onAction="#handleOnline"
                        styleClass="game-button"/>

                <Button fx:id="localMultiplayerBtn"
                        text="Local Multiplayer"
                        prefWidth="374"
                        prefHeight="130"
                        onAction="#handleLocalMultiplayer"
                        styleClass="game-button"/>

            </HBox>

            <HBox alignment="CENTER"
                  spacing="500">

                <Button fx:id="cpuBtn"
                        text="CPU"
                        prefWidth="374"
                        prefHeight="130"
                        onAction="#handleCpu"
                        styleClass="game-button"/>

                <Button fx:id="localNetworkBtn"
                        text="Local Network"
                        prefWidth="374"
                        prefHeight="130"
                        onAction="#handleLocalNetwork"
                        styleClass="game-button"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>
